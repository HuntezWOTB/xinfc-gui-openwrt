#!/bin/sh
# rpcd backend for luci-app-xinfc (XINFC_GUI_OpenWRT).
# ubus object `luci.xinfc`: getConfig, getRadios, detectChip, writeTag,
# getBackups, setLang. Same exec pattern as luci.https-dns-proxy.
#
# Manual test on router:
#   ubus -S call luci.xinfc getConfig
#   ubus -S call luci.xinfc getRadios
#   ubus -S call luci.xinfc detectChip
#   ubus -S call luci.xinfc writeTag '{"profile":"manual","ssid":"Test","key":"12345678","encryption":"sae-mixed","bus":"0","addr":"0x57"}'

readonly packageName="xinfc"
readonly toolBin="/usr/sbin/xinfc-wsc"
readonly workDir="/etc/xinfc"

. "${IPKG_INSTROOT}/lib/functions.sh"
. "${IPKG_INSTROOT}/usr/share/libubox/jshn.sh"

have_bin() { [ -x "$1" ]; }

uci_get() { uci -q get "$1"; }

# ---------- config ----------
get_config() {
	local bus addr lang
	bus="$(uci_get xinfc.main.bus)";      [ -z "$bus" ] && bus="0"
	addr="$(uci_get xinfc.main.addr)";    [ -z "$addr" ] && addr="0x57"
	lang="$(uci_get xinfc.main.lang)";    [ -z "$lang" ] && lang="en"
	json_init
	json_add_object "$packageName"
	json_add_string 'bus' "$bus"
	json_add_string 'addr' "$addr"
	json_add_string 'lang' "$lang"
	if have_bin "$toolBin"; then json_add_boolean 'tool' '1'; else json_add_boolean 'tool' '0'; fi
	if have_bin "/usr/sbin/i2cdetect"; then json_add_boolean 'i2ctools' '1'; else json_add_boolean 'i2ctools' '0'; fi
	json_close_object
	json_dump
	json_cleanup
}

set_lang() {
	local lang="$1"
	case "$lang" in ar|zh_CN|en|de|ru|es|tr|uk) ;; *) lang="en" ;; esac
	uci set xinfc.main.lang="$lang" 2>/dev/null
	uci commit xinfc 2>/dev/null
	json_init
	json_add_boolean 'ok' '1'
	json_add_string 'lang' "$lang"
	json_dump
	json_cleanup
}

# ---------- radios (dual-band profiles, keys never leave the router) ----------
band_of_channel() {
	case "$1" in
		''|*[!0-9]*) echo "unknown" ;;
		*)
			if [ "$1" -le 14 ]; then echo "2g"; else echo "5g"; fi
			;;
	esac
}

get_radios() {
	local dump radios ifaces rsec band channel isec dev
	dump="$(mktemp)"
	uci -q show wireless > "$dump" 2>/dev/null
	radios="$(sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p" "$dump")"
	ifaces="$(sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p" "$dump")"
	json_init
	json_add_object "$packageName"
	json_add_array 'radios'
	for rsec in $radios; do
		band="$(sed -n "s/^wireless\.$rsec\.band='\([^']*\)'$/\1/p" "$dump" | head -n 1)"
		channel="$(sed -n "s/^wireless\.$rsec\.channel='\([^']*\)'$/\1/p" "$dump" | head -n 1)"
		if [ -z "$band" ]; then
			band="$(sed -n "s/^wireless\.$rsec\.hwmode='\([^']*\)'$/\1/p" "$dump" | head -n 1)"
			case "$band" in
				11g|11b|11ng) band="2g" ;;
				11a|11na|11ac|11ax|11be) band="5g" ;;
				*) band="$(band_of_channel "$channel")" ;;
			esac
		fi
		[ -z "$band" ] && band="unknown"
		json_add_object ''
		json_add_string 'name' "$rsec"
		json_add_string 'band' "$band"
		json_add_string 'channel' "$channel"
		json_add_array 'ifaces'
		for isec in $ifaces; do
			dev="$(sed -n "s/^wireless\.$isec\.device='\([^']*\)'$/\1/p" "$dump" | head -n 1)"
			[ "$dev" = "$rsec" ] || continue
			json_add_object ''
			json_add_string 'name' "$isec"
			json_add_string 'ssid' "$(sed -n "s/^wireless\.$isec\.ssid='\([^']*\)'$/\1/p" "$dump" | head -n 1)"
			json_add_string 'encryption' "$(sed -n "s/^wireless\.$isec\.encryption='\([^']*\)'$/\1/p" "$dump" | head -n 1)"
			if [ -n "$(sed -n "s/^wireless\.$isec\.key='[^']*'$/yes/p" "$dump" | head -n 1)" ]; then
				json_add_boolean 'has_key' '1'
			else
				json_add_boolean 'has_key' '0'
			fi
			if [ "$(sed -n "s/^wireless\.$isec\.disabled='\([^']*\)'$/\1/p" "$dump" | head -n 1)" = "1" ]; then
				json_add_boolean 'disabled' '1'
			else
				json_add_boolean 'disabled' '0'
			fi
			json_close_object
		done
		json_close_array
		json_close_object
	done
	json_close_array
	json_dump
	json_cleanup
	rm -f "$dump"
}

# ---------- chip detect ----------
detect_chip() {
	local buses="$1" bus out addrs
	[ -z "$buses" ] && buses="0 1 2"
	if ! have_bin "/usr/sbin/i2cdetect"; then
		json_init
		json_add_object "$packageName"
		json_add_string 'error' 'no-i2c-tools'
		json_close_object
		json_dump
		json_cleanup
		return
	fi
	json_init
	json_add_object "$packageName"
	json_add_array 'buses'
	for bus in $buses; do
		case "$bus" in *[!0-9]*) continue ;; esac
		out="$(i2cdetect -y "$bus" 2>/dev/null | tail -n +2)"
		addrs="$(printf '%s' "$out" | grep -o '[0-9a-f][0-9a-f]' | sed 's/^/0x/' | tr '\n' ' ')"
		json_add_object ''
		json_add_string 'bus' "$bus"
		json_add_string 'found' "$addrs"
		json_close_object
	done
	json_close_array
	json_dump
	json_cleanup
}

# ---------- write tag ----------
write_tag() {
	local profile="$1" iface="$2" ssid="$3" key="$4" enc="$5" bus="$6" addr="$7"
	local log ok=0
	# validate bus/addr strictly (tool wants single-char bus, 0xMN addr)
	case "$bus" in [0-9]) ;; *) bus="0" ;; esac
	case "$addr" in 0[xX][0-9a-fA-F][0-9a-fA-F]) ;; *) addr="0x57" ;; esac
	if [ "$profile" = "auto" ]; then
		# ключ читаем только здесь, в браузер он не уходит
		ssid="$(uci_get "wireless.$iface.ssid")"
		enc="$(uci_get "wireless.$iface.encryption")"
		key="$(uci_get "wireless.$iface.key")"
	fi
	[ -z "$enc" ] && enc="none"
	if [ -z "$ssid" ]; then
		log="empty SSID"
	elif [ "$enc" != "none" ] && [ -z "$key" ]; then
		log="empty key for encrypted network"
	elif ! have_bin "$toolBin"; then
		log="tool missing: $toolBin"
	else
		mkdir -p "$workDir"
		log="$(cd "$workDir" && "$toolBin" "$bus" "$addr" "$ssid" "$key" "$enc" 2>&1)"
		[ $? -eq 0 ] && ok=1
		# никогда не показываем ключ в логе панели
		if [ -n "$key" ]; then
			log="$(printf '%s' "$log" | grep -vF "$key")"
		fi
	fi
	# persist last used bus/addr
	uci set xinfc.main.bus="$bus" 2>/dev/null
	uci set xinfc.main.addr="$addr" 2>/dev/null
	uci commit xinfc 2>/dev/null
	json_init
	json_add_object "$packageName"
	json_add_boolean 'ok' "$ok"
	json_add_string 'log' "$log"
	json_close_object
	json_dump
	json_cleanup
}

# ---------- backups (tool keeps nfc_ndef_backup.bin from the FIRST run) ----------
get_backups() {
	local f="$workDir/nfc_ndef_backup.bin" size=0 present=0
	if [ -f "$f" ]; then
		present=1
		size="$(wc -c < "$f" 2>/dev/null | tr -d ' ')"
	fi
	json_init
	json_add_object "$packageName"
	json_add_boolean 'stock_backup' "$present"
	json_add_int 'stock_backup_size' "${size:-0}"
	json_add_string 'stock_backup_path' "$f"
	json_close_object
	json_dump
	json_cleanup
}

case "$1" in
	list)
		json_init
		json_add_object "getConfig"
		json_close_object
		json_add_object "getRadios"
		json_close_object
		json_add_object "detectChip"
			json_add_string 'buses' "buses"
		json_close_object
		json_add_object "writeTag"
			json_add_string 'profile' "profile"
			json_add_string 'iface' "iface"
			json_add_string 'ssid' "ssid"
			json_add_string 'key' "key"
			json_add_string 'encryption' "encryption"
			json_add_string 'bus' "bus"
			json_add_string 'addr' "addr"
		json_close_object
		json_add_object "getBackups"
		json_close_object
		json_add_object "setLang"
			json_add_string 'lang' "lang"
		json_close_object
		json_dump
		json_cleanup
		;;
	call)
		case "$2" in
			getConfig) get_config ;;
			getRadios) get_radios ;;
			detectChip)
				read -r input
				json_load "$input"
				json_get_var buses "buses"
				json_cleanup
				detect_chip "$buses"
				;;
			writeTag)
				read -r input
				json_load "$input"
				json_get_var profile "profile"
				json_get_var iface "iface"
				json_get_var ssid "ssid"
				json_get_var key "key"
				json_get_var encryption "encryption"
				json_get_var bus "bus"
				json_get_var addr "addr"
				json_cleanup
				write_tag "$profile" "$iface" "$ssid" "$key" "$encryption" "$bus" "$addr"
				;;
			getBackups) get_backups ;;
			setLang)
				read -r input
				json_load "$input"
				json_get_var lang "lang"
				json_cleanup
				set_lang "$lang"
				;;
		esac
		;;
esac
